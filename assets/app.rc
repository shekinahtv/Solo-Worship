// Application resources: icon used by Explorer, the taskbar and the installer.
#include <windows.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Solo Worshiper"
            VALUE "FileDescription",  "Solo Worshiper - worship vocal and karaoke console"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SoloWorshiper"
            VALUE "OriginalFilename", "SoloWorshiper.exe"
            VALUE "ProductName",      "Solo Worshiper"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
